# OpenRouter API 密钥，无默认值
OPENROUTER_API_KEY=sk-your-key
# OpenRouter 模型名称，无默认值
OPENROUTER_MODEL=model
# System Prompt 文件路径；示例默认留空，空串表示不加载
# 必须用 ?? 语义理解：空串是有意义的取值，不等同于未设置
CAICAI_SYSTEM_PROMPT_PATH=''
# JSONL 事件日志路径，默认 ~/.caicaiclaw/history.jsonl
# 注意：`~` 不会被所有 env 加载方式展开（shell source 会，node --env-file 不会），
# 需要覆盖时请写绝对路径。留空则由代码自行拼 homedir。
# CAICAI_RAW_HISTORY_PATH=/absolute/path/to/history.jsonl
# Memory 目录（Role.md / Memory.md 等），默认从 dirname(SYSTEM_PROMPT_PATH || RAW_HISTORY_PATH) 推导
# admin 的 memory 编辑范围也由它界定，且只允许该目录内的 .md
# CAICAI_MEMORY_DIR=/absolute/path/to/memory-dir
# 每累计多少个 committed turn 自动触发一次 compact，默认 0 表示关闭
# 注意：turn 数不足 4 个时 compact 不会产生 checkpoint（DEFAULT_PRESERVED_TURNS = 3）
CAICAI_COMPACT_EVERY_TURNS=0
# WebSocket 服务监听地址，默认 127.0.0.1
CAICAI_WS_HOST=127.0.0.1
# WebSocket 服务监听端口，默认 8787
CAICAI_WS_PORT=8787
# Agent WebSocket 鉴权 token；留空时兼容现有仅监听 127.0.0.1 的无鉴权行为。
# 设置后所有客户端必须在连接 URL 的 token query 参数中携带相同值；不要使用 NEXT_PUBLIC_ 前缀。
# admin 的 Settings 页面可安全地写入覆盖值；该覆盖值默认保存在 history.jsonl 同目录的 agent-ws-token。
# CAICAI_WS_TOKEN=use-a-long-random-secret
# 可选：admin 保存 Agent WebSocket token 覆盖值的绝对路径。仅 admin supervisor 会读取它。
# CAICAI_WS_TOKEN_PATH=/absolute/path/to/agent-ws-token
# 快车道模型（单次调用 + 流式），留空回落到 OPENROUTER_MODEL 并在启动日志告知。
# 回落能跑，但快车道就没有延迟优势——它存在的唯一理由就是比 main 快。
# CAICAI_FAST_MODEL=
# 背景模型（compaction、conversation digest、daydreaming），留空同样回落到 OPENROUTER_MODEL。
# CAICAI_BACKGROUND_MODEL=
# L3 公开发布审批的过期时间（毫秒）。到期落 approval.expired，语义等同 deny 并通知 agent，
# 避免 admin 长期离线时 pending 无限积压。
# CAICAI_APPROVAL_TTL_MS=86400000
# 渠道分流与 intake 策略文件（JSONC）的绝对路径。策略由 runtime 执行，
# ws server 只做鉴权/校验/归一化/路由，不做分流决策。留空则全部走 defaults（deep + lossless）。
# CAICAI_CHANNEL_POLICY_PATH=/absolute/path/to/channels.jsonc
# 每多少次 heartbeat 为有新活动的 conversation 生成一次 digest，默认 0 表示关闭。
# digest 是由历史派生的上下文 checkpoint，可重新生成，不是长期记忆。
# CAICAI_DIGEST_EVERY_HEARTBEATS=0
# Agent 单轮最多执行的步数，默认 3
CAICAI_MAX_STEP_LIMIT=3
# 触发循环告警的重复长度，默认 1
CAICAI_LOOP_WARNING_LENGTH=1
# 浏览器端 WebSocket 连接地址，默认 ws://127.0.0.1:8787
# NEXT_PUBLIC_ 前缀会被编入客户端产物：改动后需重新构建 admin 才生效，且不要放入任何机密。
# 修改 CAICAI_WS_PORT 时必须同步此处端口，否则 /chat 会连到错误端口。
NEXT_PUBLIC_CAICAI_WS_URL=ws://127.0.0.1:8787
# TUI 端 WebSocket 连接地址，默认 ws://127.0.0.1:8787
CAICAI_TUI_WS_URL=ws://127.0.0.1:8787
# admin 端鉴权 token，无默认值：缺失时 admin 拒绝启动，不存在无认证降级路径
# 这是一个高权限面板（可写 agent 人格、可启停进程，而 agent 自身持有 exec 工具），
# 请使用足够长的随机值，不要沿用示例。校验走 timingSafeEqual，凭据只从 httpOnly cookie 读取。
CAICAI_ADMIN_TOKEN=your-secret
# admin HTTP 监听端口，默认 3001；监听地址固定 127.0.0.1，不可配置为 0.0.0.0
CAICAI_ADMIN_PORT=3001
# 停止 agent 时等待 graceful 退出的宽限期（毫秒），默认 10000；超时后发 SIGKILL
CAICAI_ADMIN_STOP_GRACE_MS=10000
# 启动 agent 后等待 control WebSocket 握手（hello）的超时（毫秒），默认 15000
# 超时即判定启动失败并终止子进程；running 状态以收到 hello 为准，而非进程存活
CAICAI_ADMIN_STARTUP_TIMEOUT_MS=15000
# QQ 开放平台机器人 AppID，用于 adapter-qq
QQ_BOT_APP_ID=your-app-id
# QQ 开放平台机器人 ClientSecret，用于 adapter-qq
QQ_BOT_CLIENT_SECRET=your-client-secret
# adapter-qq 连接到 apps/server 的 WebSocket URL，默认 ws://127.0.0.1:8787
QQ_ADAPTER_SERVER_WS_URL=ws://127.0.0.1:8787
