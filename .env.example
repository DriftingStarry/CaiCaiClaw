# OpenRouter API 密钥，无默认值
OPENROUTER_API_KEY=sk-your-key
# OpenRouter 模型名称，无默认值
OPENROUTER_MODEL=model
# System Prompt 文件路径；示例默认留空，空串表示不加载
CAICAI_SYSTEM_PROMPT_PATH=''
# JSONL 事件日志路径，默认 ~/.caicaiclaw/history.jsonl
# 注意：`~` 不会被所有 env 加载方式展开（shell source 会，node --env-file 不会），
# 需要覆盖时请写绝对路径。留空则由代码自行拼 homedir。
# CAICAI_RAW_HISTORY_PATH=/absolute/path/to/history.jsonl
# WebSocket 服务监听地址，默认 127.0.0.1
CAICAI_WS_HOST=127.0.0.1
# WebSocket 服务监听端口，默认 8787
CAICAI_WS_PORT=8787
# Web 端 WebSocket 连接地址，默认 ws://127.0.0.1:8787
NEXT_PUBLIC_CAICAI_WS_URL=ws://127.0.0.1:8787
